generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["ceyora_db", "public"]
}

model C1Customer {
  customerId   Int         @id @default(autoincrement()) @map("customer_id")
  firstName    String      @map("first_name") @db.VarChar(255)
  lastName     String      @map("last_name") @db.VarChar(255)
  country      String      @db.VarChar(255)
  email        String?     @unique @db.VarChar(255)
  phoneNumber  String?     @map("phone_number") @db.VarChar(20)
  created_at   DateTime?   @default(now()) @db.Timestamp(6)
  updated_at   DateTime?   @default(now()) @db.Timestamp(6)
  username     String      @unique @db.VarChar(32)
  password     String      @map("c1_password") @db.VarChar(255)
  languagePref String?     @map("language_pref") @db.VarChar(5)
  journeys     J1Journey[]

  @@map("c1_customer")
  @@schema("ceyora_db")
}

model V1Vendor {
  vendorId             Int              @id @default(autoincrement()) @map("vendor_id")
  themeId              Int              @map("t1Theme_id")
  location             String           @db.VarChar(255)
  totalRatePoints      Int?             @default(0) @map("total_rate_points")
  rateCount            Int?             @default(0) @map("rate_count")
  vendorTitle          String           @map("vendor_title") @db.VarChar(255)
  vendorDescription    String           @map("vendor_description")
  vendorAdditionalData String?          @map("vendor_additional_data")
  vendorRegisteredDate DateTime?        @map("vendor_registered_date") @db.Timestamp(6)
  vendorContactNumber1 String           @map("vendor_contact_number_1") @db.VarChar
  vendorContactNumber2 String?          @map("vendor_contact_number_2") @db.VarChar
  vendorEmail          String?          @map("vendor_email") @db.VarChar
  hostLanguages        String[]         @map("host_languages")
  hostImageUrl         String?          @map("host_image_url")
  hostBio              String?          @map("host_bio")
  journeys             J1Journey[]
  packages             P1Package[]
  theme                T1Theme          @relation(fields: [themeId], references: [themeId], onDelete: NoAction, onUpdate: NoAction, map: "fk_theme_vendor")
  regions              W1VendorRegion[]

  @@map("v1_vendor")
  @@schema("ceyora_db")
}

model P1Package {
  packageId          Int         @id @default(autoincrement()) @map("package_id")
  vendorId           Int         @map("vendor_id")
  packageDescription String      @map("package_description")
  price              Decimal     @db.Decimal
  priceUSD           Decimal?    @map("price_usd") @db.Decimal // 👈 JSON/TS stays priceUSD
  duration           String?     @db.VarChar(50)
  journeys           J1Journey[]
  vendor             V1Vendor    @relation(fields: [vendorId], references: [vendorId], onDelete: NoAction, onUpdate: NoAction, map: "fk_package_vendor")

  @@map("p1_package")
  @@schema("ceyora_db")
}

model T1Theme {
  themeId          Int        @id @default(autoincrement()) @map("theme_id")
  themeTitle       String     @map("theme_title") @db.VarChar(255)
  themeDescription String?    @map("theme_description")
  vendors          V1Vendor[]

  @@map("t1Theme")
  @@schema("ceyora_db")
}

model W1VendorRegion {
  vendorId  Int       @map("vendor_id")
  regionId  Int       @map("region_id")
  r1_region r1_region @relation(fields: [regionId], references: [r1_region_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vendor_region_region_id")
  vendor    V1Vendor  @relation(fields: [vendorId], references: [vendorId], onDelete: NoAction, onUpdate: NoAction, map: "fk_vendor_region_vendor_id")

  @@id([vendorId, regionId])
  @@map("w1_vendor_region")
  @@schema("ceyora_db")
}

model J1Journey {
  journeyId          Int        @id @default(autoincrement()) @map("journey_id")
  customerId         Int        @map("customer_id")
  vendorId           Int?       @map("vendor_id")
  scheduledDateTime  DateTime?  @map("scheduled_date_time") @db.Timestamp(6)
  packageId          Int?       @map("package_id")
  isCancelled        Int?       @map("is_cancelled")
  cancelledDate      DateTime?  @map("cancelled_date") @db.Timestamp(6)
  isRefunded         Int?       @map("is_refunded")
  refundedDate       DateTime?  @map("refunded_date") @db.Timestamp(6)
  lastUpdatedDate    DateTime?  @map("last_updated_date") @db.Timestamp(6)
  isVendorApproved   Int?       @map("is_vendor_approved")
  vendorApprovedDate DateTime?  @map("vendor_approved_date") @db.Timestamp(6)
  customer           C1Customer @relation(fields: [customerId], references: [customerId], onDelete: NoAction, onUpdate: NoAction, map: "fk_journey_customer")
  package            P1Package? @relation(fields: [packageId], references: [packageId], onDelete: NoAction, onUpdate: NoAction, map: "fk_journey_package")
  vendor             V1Vendor?  @relation(fields: [vendorId], references: [vendorId], onDelete: NoAction, onUpdate: NoAction, map: "fk_journey_vendor")

  @@map("j1_journey")
  @@schema("ceyora_db")
}

model r1_region {
  r1_region_id     Int              @id @default(autoincrement())
  r1_region_name   String?          @db.VarChar(255)
  search_times     Int?
  r1_district_id   Int?
  l2_district      l2_district?     @relation(fields: [r1_district_id], references: [district_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_region_district")
  w1_vendor_region W1VendorRegion[]

  @@schema("ceyora_db")
}

model l2_district {
  district_id    Int                    @id @default(autoincrement())
  district_name  String?                @db.VarChar(255)
  l2_province_id Int?
  l1_province    ceyora_db_l1_province? @relation(fields: [l2_province_id], references: [province_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_district_province")
  r1_region      r1_region[]

  @@schema("ceyora_db")
}

model ceyora_db_l1_province {
  province_id   Int           @id @default(autoincrement())
  province_name String?       @db.VarChar(255)
  l2_district   l2_district[]

  @@map("l1_province")
  @@schema("ceyora_db")
}

model public_l1_province {
  province_id   Int     @id @default(autoincrement())
  province_name String? @db.VarChar(255)

  @@map("l1_province")
  @@schema("public")
}
